#!/bin/sh
# Fake install: log the call and copy the source to the destination for -D -m 0644 <source> <destination>, making the parent folders.
# It refuses a destination outside the folder of the test.
printf 'install %s\n' "$*" >>"$FAKE_LOG"
[ "$1 $2 $3" = '-D -m 0644' ] && [ $# -eq 5 ] || {
	echo "fake install: unexpected $*" >&2
	exit 1
}
"$FAKE_BIN/fake-path-guard" install "$5" || exit 1
/bin/mkdir -p "$(dirname "$5")" && cp "$4" "$5"
