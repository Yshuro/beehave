#!/bin/sh
# Fake install: log the call and run the three forms of the script, and nothing else.
#   install -D -m MODE <source> <destination>             copy a file and make the parent folders
#   install -d -m MODE -o OWNER -g GROUP <folder>         make a folder
#   install -m MODE -o OWNER -g GROUP <source> <destination>   copy a file
# It refuses a path outside the folder of the test.
printf 'install %s\n' "$*" >>"$FAKE_LOG"
case $1 in
-D)
	[ $# -eq 5 ] && [ "$2 $3" = '-m 0644' ] || {
		echo "fake install: unexpected $*" >&2
		exit 1
	}
	"$FAKE_BIN/fake-path-guard" install "$5" || exit 1
	/bin/mkdir -p "$(dirname "$5")" && cp "$4" "$5"
	;;
-d)
	[ $# -eq 8 ] && [ "$2 $4 $6" = '-m -o -g' ] || {
		echo "fake install: unexpected $*" >&2
		exit 1
	}
	"$FAKE_BIN/fake-path-guard" install "$8" || exit 1
	/bin/mkdir -p "$8"
	;;
-m)
	[ $# -eq 8 ] && [ "$3 $5" = '-o -g' ] || {
		echo "fake install: unexpected $*" >&2
		exit 1
	}
	"$FAKE_BIN/fake-path-guard" install "$8" || exit 1
	cp "$7" "$8"
	;;
*)
	echo "fake install: unexpected $*" >&2
	exit 1
	;;
esac
