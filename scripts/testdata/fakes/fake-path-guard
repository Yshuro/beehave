#!/bin/sh
# Path guard of the fakes that run a real tool: fail unless each path is in FAKE_BASE, the folder of the test.
# So a script that passes a path it must refuse cannot change the real filesystem.
# Usage: fake-path-guard <name of the fake> <path>...
name=$1
shift
for path; do
	canonical=$("$REAL_REALPATH" -m -- "$path") || exit 1
	case $canonical in
	"$FAKE_BASE"/*) ;;
	*)
		echo "fake $name: refused $path, which is outside the folder of the test" >&2
		exit 1
		;;
	esac
done
