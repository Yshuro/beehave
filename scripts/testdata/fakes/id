#!/bin/sh
# Fake id: the login user builder, with the user id from FAKE_UID and the groups from FAKE_GROUPS (builder).
# `id -u beehave-jobs` and `id -nG beehave-jobs` read the job user: it exists once the fake useradd made the file jobuser in FAKE_STATE,
# and its groups are FAKE_JOB_GROUPS (beehave-jobs).
user=
for arg; do
	case $arg in
	-*) ;;
	*) user=$arg ;;
	esac
done
if [ -n "$user" ]; then
	[ "$user" = beehave-jobs ] && [ -f "$FAKE_STATE/jobuser" ] || {
		echo "id: '$user': no such user" >&2
		exit 1
	}
	groups=${FAKE_JOB_GROUPS:-beehave-jobs}
	uid=1001
else
	groups=${FAKE_GROUPS:-builder}
	uid=${FAKE_UID:-1000}
fi
case $1 in
-u) echo "$uid" ;;
-un | -gn) echo builder ;;
-nG) echo "$groups" ;;
*)
	echo "fake id: unexpected $*" >&2
	exit 1
	;;
esac
