#!/bin/sh
# Fake sudo: log the call, and run the command only when it is a fake of the test. A real command never runs.
printf 'sudo %s\n' "$*" >>"$FAKE_LOG"
if [ "$1" = -n ]; then exit "${FAKE_SUDO_RC:-0}"; fi
case $1 in *=*) shift ;; esac
case $(command -v "$1") in "$FAKE_BIN"/*) exec "$@" ;; esac
exit 0
